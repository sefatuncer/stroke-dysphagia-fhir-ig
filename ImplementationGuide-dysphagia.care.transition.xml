      </reference>
      <name value="Dysphagia Nutrition Order (IDDSI-bound)"/>
      <description value="NutritionOrder constrained to bind IDDSI levels (extensible) — base FHIR only binds these 'example'."/>
      <exampleBoolean value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="CodeSystem"/>
      </extension>
      <reference>
        <reference value="CodeSystem/dysphagia-scales-temp"/>
      </reference>
      <name value="Dysphagia Scales — temporary local codes (proposed for LOINC/SNOMED)"/>
