# Build outputs and caches (regenerable, reproduced by the toolchain)
ig/output/
ig/temp/
ig/fsh-generated/
ig/input-cache/
ig/template/
ig/evaluation/.tools/
ig/evaluation/elm/
# 4 MB of per-resource OperationOutcomes; conformance/out/cohort-conformance.{json,md}
# carries the verdict and the error/warning signatures.
ig/conformance/out/cohort-validator-raw.json
# ig/evaluation/cohort/ is deliberately NOT ignored. Every downstream step —
# CQL execution, the mutation controls, the metrics — reads the cohort rather
# than the Synthea export, so depositing it (0.7 MB, 333 bundles) reproduces
# every reported result without re-running the generator.
# The Synthea export itself is 232 MB and stays out, but its run record does
# not: metadata/ carries the build, the seeds and the generation parameters.
ig/evaluation/synthea-out/*
!ig/evaluation/synthea-out/metadata/
**/node_modules/

# Large binaries fetched by the toolchain (not source)
*.jar
*.tgz
*.zip

# Personal documents
*.pdf

# Local working directories (not part of the public artifact)
/review/
# The manuscript sources stay private, but the supplementary files the paper
# declares as openly available (S2-S6) are part of the public artifact.
/submission/*
!/submission/supplement/

# OS and editor cruft
.DS_Store
Thumbs.db

# Gönderim için üretilen ek kopyaları (kaynak .md depoda; .docx yalnız yükleme içindir)
submission/supplement/*.docx
