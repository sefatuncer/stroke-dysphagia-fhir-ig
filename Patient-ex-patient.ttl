# - resource -------------------------------------------------------------------

<https://sefatuncer.github.io/stroke-dysphagia-fhir-ig/Patient/ex-patient> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ex-patient"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient ex-patient</b></p><a name=\"ex-patient\"> </a><a name=\"hcex-patient\"> </a><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Ornek Sentetik  Female, DoB: 1957-05-12</p><hr/></div>"
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Sentetik" ] ;
     fhir:HumanName.given [
       fhir:value "Ornek" ;
       fhir:index 0
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "female"] ;
  fhir:Patient.birthDate [ fhir:value "1957-05-12"^^xsd:date] .

# - ontology header ------------------------------------------------------------

<https://sefatuncer.github.io/stroke-dysphagia-fhir-ig/Patient/ex-patient.ttl> a owl:Ontology ;
