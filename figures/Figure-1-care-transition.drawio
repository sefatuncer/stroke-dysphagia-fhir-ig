        <mxCell id="comp" value="DysphagiaCareTransitionSummary&#10;(Composition)&#10;&#10;bundles the profiled elements into&#10;one transfer package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
