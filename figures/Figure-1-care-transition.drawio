        <!-- Interoperability dependency banner (red) -->
        <mxCell id="interop" value="Interoperability dependency (illustrative mechanism): a CODED aspiration-risk flag is visible to the computable check; the same flag left as UN-CODED free text is not. In the synthetic evaluation the invisible fraction tracks the un-coded fraction by construction (≈1−P), a feasibility mechanism, not a clinical measurement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
