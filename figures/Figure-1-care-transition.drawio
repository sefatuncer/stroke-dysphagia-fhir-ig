        <!-- Transfer of the bundle -->
        <mxCell id="transfer" value="care-transition&#10;bundle" style="endArrow=classic;html=1;fontSize=10;fontStyle=1;strokeColor=#6c8ebf;strokeWidth=3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="comp" target="cql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Downstream computable check (purple) -->
        <mxCell id="cql" value="AspirationRiskAlert (CQL)&#10;computable safety-consistency check&#10;runs on the received bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="200" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="alert" value="Alert if: at-risk flag + thin (IDDSI L0) fluids + not NPO&#10;&#8594; review diet / fluid consistency &amp; swallowing precautions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;dashed=1;" vertex="1" parent="1">
